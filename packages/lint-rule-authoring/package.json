{
  "name": "@mst/lint-rule-authoring",
  "version": "0.0.0",
  "description": "Materials for authoring lint rules that keep working after they are written.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/mst.git",
    "directory": "packages/lint-rule-authoring"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./plugin": "./src/plugin.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/core": "catalog:",
    "@opentelemetry/exporter-metrics-otlp-http": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-metrics": "catalog:",
    "@oxlint/plugins": "catalog:",
    "es-toolkit": "catalog:",
    "oxlint": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "lintRules": [
    "src/lint/oxlint/rules"
  ]
}
