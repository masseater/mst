{
  "name": "@mst/lint-rule-authoring",
  "version": "0.0.0",
  "description": "Materials for authoring lint rules that keep working after they are written.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/mst.git",
    "directory": "packages/lint-rule-authoring"
  },
  "bin": {
    "lint-rule-authoring": "./src/cli.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./plugin": "./src/plugin.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@mst/repository-checks": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@oxlint/plugins": "catalog:",
    "es-toolkit": "catalog:",
    "oxc-parser": "catalog:",
    "oxlint": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "lintRules": [
    "src/lint/oxlint/rules"
  ]
}
