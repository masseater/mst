{
  "name": "@mst/lint-rule-authoring",
  "version": "0.0.0",
  "description": "Materials for authoring lint rules that keep working after they are written.",
  "keywords": [
    "tanstack-intent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/mst.git",
    "directory": "packages/lint-rule-authoring"
  },
  "bin": {
    "lint-rule-authoring": "./src/cli.ts"
  },
  "files": [
    "dist",
    "skills",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./plugin": "./src/plugin.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "bin": {
      "lint-rule-authoring": "./dist/cli.mjs"
    },
    "exports": {
      ".": "./dist/index.mjs",
      "./plugin": "./dist/plugin.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "spool -- vp pack",
    "dev": "vp pack --watch",
    "test": "spool -- vp test",
    "check": "spool -- vp check",
    "check:skills": "intent validate"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@oxlint/plugins": "catalog:",
    "es-toolkit": "catalog:",
    "oxc-parser": "catalog:",
    "oxlint": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@mst/ai-native": "workspace:*",
    "@mst/repository-checks": "workspace:*",
    "@tanstack/intent": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "inlinedDependencies": {
    "@vitest/pretty-format": "4.1.10",
    "@vitest/runner": "4.1.10",
    "@vitest/utils": "4.1.10",
    "tinyrainbow": "3.1.1"
  },
  "lintRules": [
    "src/lint/oxlint/rules"
  ]
}
