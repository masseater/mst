{
  "name": "@mst/agentic-documents",
  "version": "0.0.0",
  "description": "AI-facing documents that stay true to the repository and keep a shape machines can follow.",
  "keywords": [
    "tanstack-intent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/mst.git",
    "directory": "packages/agentic-documents"
  },
  "bin": {
    "agentic-documents": "./src/cli.ts"
  },
  "files": [
    "dist",
    "skills",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "spool -- vp pack",
    "dev": "vp pack --watch",
    "test": "spool -- vp test",
    "check": "spool -- vp check",
    "check:skills": "intent validate"
  },
  "dependencies": {
    "@mst/repository-checks": "workspace:*",
    "es-toolkit": "catalog:",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@mst/ai-native": "workspace:*",
    "@tanstack/intent": "catalog:",
    "@types/mdast": "^4.0.4",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
