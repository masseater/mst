{
  "name": "@mst/dont-review-it",
  "version": "0.0.0",
  "description": "Machine-enforced answers to the writing questions that would otherwise be raised in review.",
  "keywords": [
    "tanstack-intent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/mst.git",
    "directory": "packages/dont-review-it"
  },
  "bin": {
    "dont-review-it": "./src/cli.ts"
  },
  "files": [
    "dist",
    "skills",
    "src",
    "tsconfig"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./plugin": "./src/plugin.ts",
    "./vitest": "./src/vitest/standard-io-test.ts",
    "./package.json": "./package.json",
    "./tsconfig/*": "./tsconfig/*"
  },
  "publishConfig": {
    "bin": {
      "dont-review-it": "./dist/cli.mjs"
    },
    "exports": {
      ".": "./dist/index.mjs",
      "./plugin": "./dist/plugin.mjs",
      "./vitest": "./dist/vitest.mjs",
      "./package.json": "./package.json",
      "./tsconfig/*": "./tsconfig/*"
    },
    "access": "public"
  },
  "scripts": {
    "build": "spool -- vp pack",
    "dev": "vp pack --watch",
    "test": "spool -- vp test",
    "check": "spool -- vp check",
    "check:skills": "intent validate"
  },
  "dependencies": {
    "@mst/lint-rule-authoring": "workspace:*",
    "@oxlint/plugins": "catalog:",
    "citty": "0.2.2",
    "es-toolkit": "catalog:",
    "jsonc-parser": "catalog:",
    "oxc-parser": "catalog:",
    "oxfmt": "0.61.0",
    "oxlint": "catalog:",
    "std-env": "^4.2.0",
    "typescript": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@mst/ai-native": "workspace:*",
    "@mst/repository-checks": "workspace:*",
    "@tanstack/intent": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "vite-plus": "catalog:"
  },
  "lintRules": [
    "src/lint/oxlint/rules"
  ]
}
