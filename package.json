{
  "name": "mst",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/mst.git"
  },
  "type": "module",
  "scripts": {
    "guard": "vp check && vp run -r test --coverage && vp run -r build && vp run knip && vp run knip --production && vp exec dont-review-it check && vp exec agentic-documents check && vp run -r check:skills",
    "guard:fix": "vp check --fix && vp exec agentic-documents check --write",
    "dev": "vp run website#dev",
    "knip": "knip",
    "prepare": "vp config && git config merge.ff false"
  },
  "devDependencies": {
    "@mst/agentic-documents": "workspace:*",
    "@mst/dont-review-it": "workspace:*",
    "@mst/lint-rule-authoring": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "knip": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.7.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
